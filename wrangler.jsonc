{
  // marketing (databayt.org) on Cloudflare Workers via OpenNext — no container.
  //
  // The $0-incremental lane (same recipe as databayt/food, space and co): OpenNext bundles the whole
  // Next server into one Worker. Build + deploy with scripts/deploy-cloudflare.sh, which builds in a
  // throwaway directory so it can switch the Prisma generator to `runtime = "workerd"` without
  // touching local `next dev`.
  // The apex and www records in the databayt.org zone are proxied placeholders (AAAA 100::); these
  // routes are what actually serve them. The apex 301s to www via a Cloudflare redirect rule.
  // History: this was a Cloudflare Container (basic) until 2026-10-24.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketing",
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Tells src/lib/db.ts to use the per-request Neon client.
    "CF_WORKERS": "1",
    "AUTH_URL": "https://www.databayt.org"
  },
  // ISR incremental cache (open-next.config.ts).
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "7b4fab07648040a985f2dc848347467a" }],
  // revalidatePath / revalidateTag tag cache (open-next.config.ts).
  "durable_objects": {
    "bindings": [{ "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketingContainer"] },
    // The container is gone: drop its class and add the OpenNext tag cache.
    { "tag": "v2", "deleted_classes": ["MarketingContainer"], "new_sqlite_classes": ["DOShardedTagCache"] }
  ],
  // OpenNext calls back into its own Worker when revalidating.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "marketing" }],
  "routes": [
    { "pattern": "databayt.org/*", "zone_name": "databayt.org" },
    { "pattern": "www.databayt.org/*", "zone_name": "databayt.org" }
  ]
}
