# Headers for the Workers Static Assets that scripts/deploy-cloudflare.sh copies into
# .cf-assets (the Next build's /_next/static plus /public), served from Cloudflare's edge.
# Build output is content-hashed, so it never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# /public files keep their names across deploys: a day fresh, then revalidated in the background.
/site/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/projects/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/contributors/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sponser/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/bubble-tiptap.riv
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/robot.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
